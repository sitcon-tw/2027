---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const redirectTo = `${baseUrl}/cfp/`;
const canonical = new URL(redirectTo, Astro.site);
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SITCON 2027 徵稿</title>
    <link rel="canonical" href={canonical} />
    <script is:inline define:vars={{ redirectTo }}>
      window.location.replace(redirectTo + window.location.search + window.location.hash);
    </script>
    <noscript><meta http-equiv="refresh" content={`0;url=${redirectTo}`} /></noscript>
  </head>
  <body>
    <p>前往 <a href={redirectTo}>SITCON 2027 徵稿網站</a>。</p>
  </body>
</html>

---
import { Picture } from "astro:assets";
import { ArrowDown, ArrowUpRight, CalendarDays, MapPin } from "@lucide/astro";
import heroImage from "../assets/sitcon-2026-crew.jpg";
import CommunityStories from "../components/CommunityStories.astro";
import AttendeeReview from "../components/AttendeeReview.astro";
import MediaReport from "../components/MediaReport.astro";
import About from "../components/About.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SignalTrees from "../components/SignalTrees.astro";
import { siteConfig } from "../data/site";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="top" class="hero" aria-labelledby="hero-heading">
      <div class="hero-photo" aria-hidden="true">
        <Picture
          src={heroImage}
          alt=""
          formats={["avif", "webp"]}
          widths={[640, 960, 1280, 1600, 2048]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="hero-mask" aria-hidden="true"></div>
      <SignalTrees />
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="shell hero-inner">
        <div class="hero-content">
          <div class="hero-title-wrap">
            <h1 id="hero-heading" class="hero-identity">SITCON 學生計算機年會</h1>
          </div>
          <div class="hero-side">
            <p class="hero-theme">{siteConfig.tagline.map((part) => <span>{part}</span>)}</p>
            <p class="hero-description">{siteConfig.portal.introduction}</p>
            <div class="hero-links">
            <div class="portal-actions">
              {siteConfig.portal.archiveLinks.map((link, index) => (
                <a class:list={["primary-button", { "secondary-button": index === 1 }]} href={link.url} target="_blank" rel="noopener noreferrer">
                  {link.label}<ArrowUpRight size={20} aria-hidden="true" />
                </a>
              ))}
            </div>
            <p class="portal-note">{siteConfig.portal.notice}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <a class="next-band" href="#about">
      <span>認識我們</span>
      <strong>從學生出發，連結更大的資訊社群</strong>
      <ArrowDown size={23} aria-hidden="true" />
    </a>

    <About />
    <CommunityStories />
    <AttendeeReview />
    <MediaReport />
    <section id="event" class="section event-section" aria-labelledby="event-heading">
      <div class="shell">
        <p class="eyebrow">See you in 2027</p>
        <h2 id="event-heading">下一次相聚，<br />SITCON 2027。</h2>
        <div class="event-strip">
          <div class="event-date"><CalendarDays size={22} aria-hidden="true" /><span class="event-info"><small>年會日期</small><strong>{siteConfig.dateDisplay}</strong></span></div>
          <div class="event-place"><MapPin size={22} aria-hidden="true" /><span class="event-info"><small>地點</small><strong>{siteConfig.venue}</strong></span></div>
        </div>
        <p class="event-notice">{siteConfig.portal.notice}</p>
        <p class="event-invitation">讓更多學生擁有交流與實作的舞台。歡迎與我們聊聊，一起支持下一次相聚。</p>
        <div class="event-archive-links">
          {siteConfig.portal.archiveLinks.map(link => <a class="text-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<ArrowUpRight size={18} aria-hidden="true" /></a>)}
          <a class="text-link" href={siteConfig.links.contact}>合作洽詢<ArrowUpRight size={18} aria-hidden="true" /></a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

</Layout>

---
import { Picture } from "astro:assets";
import { ArrowDown, ArrowUpRight, CalendarDays, MapPin } from "@lucide/astro";
import heroImage from "../assets/sitcon-2026-crew.jpg";
import About from "../components/About.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Recruitment from "../components/Recruitment.astro";
import SignalTrees from "../components/SignalTrees.astro";
import Timeline from "../components/Timeline.astro";
import { siteConfig } from "../data/site";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="top" class="hero" aria-labelledby="hero-heading">
      <div class="hero-photo" aria-hidden="true">
        <Picture
          src={heroImage}
          alt=""
          formats={["avif", "webp"]}
          widths={[640, 960, 1280, 1600, 2048]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="hero-mask" aria-hidden="true"></div>
      <SignalTrees />
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="shell hero-inner">
        <div class="hero-content">
          <div class="hero-title-wrap">
            <h1 id="hero-heading">SITCON<br />2027</h1>
          </div>
          <div class="hero-side">
            <p class="hero-theme">{siteConfig.tagline}</p>
            <p>SITCON 由學生自發籌辦。依照你的專長與興趣加入籌備團隊，和我們一起把想法變成明年的年會現場。</p>
            <a class="primary-button" href={siteConfig.recruitment.overviewUrl} target="_blank" rel="noreferrer">
              查看招募資訊
              <ArrowUpRight size={20} stroke-width={2.3} aria-hidden="true" />
            </a>
          </div>
        </div>

        <div class="event-strip">
          <div class="event-date">
            <CalendarDays size={20} stroke-width={1.8} aria-hidden="true" />
            <span class="event-info"><small>年會日期</small><strong>{siteConfig.dateDisplay}</strong></span>
          </div>
          <div class="event-place">
            <MapPin size={20} stroke-width={1.8} aria-hidden="true" />
            <span class="event-info"><small>地點</small><strong>{siteConfig.venue}</strong></span>
          </div>
          <div class="countdown" data-countdown data-target={siteConfig.startDate} aria-live="polite">
            <span><strong data-days>---</strong><small>Days</small></span>
            <span><strong data-hours>--</strong><small>Hours</small></span>
            <span><strong data-minutes>--</strong><small>Mins</small></span>
          </div>
        </div>
      </div>
    </section>

    <a class="next-band" href="#timeline">
      <span>持續更新</span>
      <strong>查看籌備時程</strong>
      <ArrowDown size={23} aria-hidden="true" />
    </a>

    <Timeline />
    <Recruitment />
    <About />
  </main>
  <Footer />

  <script>
    const countdown = document.querySelector<HTMLElement>("[data-countdown]");
    const target = countdown?.dataset.target ? new Date(countdown.dataset.target).getTime() : 0;

    const updateCountdown = () => {
      if (!countdown || !target) return;
      const remaining = Math.max(0, target - Date.now());
      const days = Math.floor(remaining / 86_400_000);
      const hours = Math.floor((remaining % 86_400_000) / 3_600_000);
      const minutes = Math.floor((remaining % 3_600_000) / 60_000);
      const dayNode = countdown.querySelector("[data-days]");
      const hourNode = countdown.querySelector("[data-hours]");
      const minuteNode = countdown.querySelector("[data-minutes]");
      if (dayNode) dayNode.textContent = String(days).padStart(3, "0");
      if (hourNode) hourNode.textContent = String(hours).padStart(2, "0");
      if (minuteNode) minuteNode.textContent = String(minutes).padStart(2, "0");
    };

    updateCountdown();
    window.setInterval(updateCountdown, 60_000);
  </script>
</Layout>

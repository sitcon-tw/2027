---
import { Picture } from "astro:assets";
import { ArrowDown, ArrowUpRight, CalendarDays, MapPin, Pizza, Users } from "@lucide/astro";
import heroImage from "../assets/sitcon-2026-crew.jpg";
import About from "../components/About.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Recruitment from "../components/Recruitment.astro";
import SignalTrees from "../components/SignalTrees.astro";
import Timeline from "../components/Timeline.astro";
import { siteConfig } from "../data/site";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="top" class="hero" aria-labelledby="hero-heading">
      <div class="hero-photo" aria-hidden="true">
        <Picture
          src={heroImage}
          alt=""
          formats={["avif", "webp"]}
          widths={[640, 960, 1280, 1600, 2048]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="hero-mask" aria-hidden="true"></div>
      <SignalTrees />
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="shell hero-inner">
        <div class="hero-content">
          <div class="hero-perks" aria-label="活動特色">
            <div class="hero-perk hero-perk-open">
              <Users size={30} stroke-width={1.9} aria-hidden="true" />
              <span><small>不用報名、不限身分</small><strong>自由參加</strong></span>
            </div>
            <div class="hero-perk hero-perk-pizza">
              <Pizza size={30} stroke-width={1.9} aria-hidden="true" />
              <span><small>來就請你吃</small><strong>免費披薩</strong></span>
            </div>
          </div>

          <div class="hero-message">
            <div class="hero-title-wrap">
              <p class="hero-kicker">SITCON 2027 籌備開放聚會 <span>BoF</span></p>
              <h1 id="hero-heading">來吃披薩，<br /><span>一起做年會。</span></h1>
            </div>
            <div class="hero-side">
              <p class="hero-description">想知道 SITCON 是怎麼辦出來的？我們會介紹今年要做什麼、各組的詳細工作內容。你不需要任何經驗，也不用先決定要加入，過來聽聽、吃披薩、交朋友就好。</p>
              <a class="primary-button bof-button" href={siteConfig.bof.signupUrl} target="_blank" rel="noreferrer">
                <span><small>到 Google Docs 留下名字</small>我要來參加</span>
                <ArrowUpRight size={30} stroke-width={2.3} aria-hidden="true" />
              </a>
            </div>
          </div>

          <div class="hero-event-card">
            <div class="hero-event-date">
              <CalendarDays size={24} stroke-width={1.8} aria-hidden="true" />
              <span><small>8 月 8 日・星期六</small><strong>17:00–21:00</strong></span>
            </div>
            <div class="hero-event-place">
              <MapPin size={24} stroke-width={1.8} aria-hidden="true" />
              <span><small>台師大公館校區</small><strong>理學 E 館 E102</strong></span>
            </div>
            <p>帶著好奇心來就可以。</p>
          </div>
        </div>
      </div>
    </section>

    <a class="next-band" href="#timeline">
      <span>持續更新</span>
      <strong>查看籌備時程</strong>
      <ArrowDown size={23} aria-hidden="true" />
    </a>

    <Timeline />
    <Recruitment />
    <About />
  </main>
  <Footer />
</Layout>

<canvas class="signal-garden" data-signal-garden aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("[data-signal-garden]");
  const context = canvas?.getContext("2d");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  type Signal = {
    x: number;
    y: number;
    radius: number;
    speed: number;
    phase: number;
    color: string;
  };

  let signals: Signal[] = [];
  let frame = 0;
  let animationId = 0;

  const makeSignals = (width: number, height: number) => {
    const count = Math.max(22, Math.min(52, Math.floor(width / 28)));
    signals = Array.from({ length: count }, (_, index) => ({
      x: ((index * 83) % width) + 6,
      y: height * (0.04 + (((index * 47) % 92) / 100)),
      radius: 1.5 + (index % 4) * 0.7,
      speed: 0.14 + (index % 5) * 0.025,
      phase: index * 0.6,
      color: index % 7 === 0 ? "#ff625b" : index % 5 === 0 ? "#7d88ff" : "#c9ff3d",
    }));
  };

  const resize = () => {
    if (!canvas || !context) return;
    const ratio = Math.min(window.devicePixelRatio || 1, 2);
    const rect = canvas.getBoundingClientRect();
    canvas.width = Math.round(rect.width * ratio);
    canvas.height = Math.round(rect.height * ratio);
    context.setTransform(ratio, 0, 0, ratio, 0, 0);
    makeSignals(rect.width, rect.height);
  };

  const drawPlant = (x: number, baseY: number, size: number, color: string) => {
    if (!context) return;
    context.strokeStyle = color;
    context.lineWidth = 2;
    context.beginPath();
    context.moveTo(x, baseY);
    context.lineTo(x, baseY - size);
    context.lineTo(x - size * 0.35, baseY - size * 1.25);
    context.moveTo(x, baseY - size * 0.65);
    context.lineTo(x + size * 0.38, baseY - size * 0.94);
    context.stroke();
    context.fillStyle = color;
    context.fillRect(x - 3, baseY - size - 3, 6, 6);
    context.fillRect(x - size * 0.35 - 3, baseY - size * 1.25 - 3, 6, 6);
    context.fillRect(x + size * 0.38 - 3, baseY - size * 0.94 - 3, 6, 6);
  };

  const draw = () => {
    if (!canvas || !context) return;
    const width = canvas.clientWidth;
    const height = canvas.clientHeight;
    context.clearRect(0, 0, width, height);

    context.strokeStyle = "rgba(243, 240, 231, 0.1)";
    context.lineWidth = 1;
    signals.forEach((signal, index) => {
      const next = signals[(index + 7) % signals.length];
      const distance = Math.hypot(signal.x - next.x, signal.y - next.y);
      if (distance < 180) {
        context.beginPath();
        context.moveTo(signal.x, signal.y);
        context.lineTo(next.x, next.y);
        context.stroke();
      }
    });

    signals.forEach((signal) => {
      const float = reduceMotion.matches ? 0 : Math.sin(frame * signal.speed * 0.06 + signal.phase) * 8;
      context.fillStyle = signal.color;
      context.fillRect(signal.x - signal.radius, signal.y + float - signal.radius, signal.radius * 2, signal.radius * 2);

    });

    drawPlant(width * 0.72, height * 0.91, Math.min(width * 0.08, 72), "#c9ff3d");
    drawPlant(width * 0.88, height * 0.96, Math.min(width * 0.05, 44), "#ff625b");
    drawPlant(width * 0.58, height * 0.98, Math.min(width * 0.035, 32), "#7d88ff");

    frame += 1;
    animationId = window.requestAnimationFrame(draw);
  };

  resize();
  draw();
  window.addEventListener("resize", resize, { passive: true });
  document.addEventListener("astro:before-swap", () => window.cancelAnimationFrame(animationId), { once: true });
</script>
